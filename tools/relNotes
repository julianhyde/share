# Generates release notes (to go into HISTORY.md).
# Usage:
#   relNotes
#
# If you require release notes since a specific commit (such as the
# commit of the last release), specify this commit as first argument:
#   relNotes abc123
#
# Set WIDTH to fold at other than 81 columns. Continuation lines are
# indented by 2, so they can be 2 columns wider than WIDTH; a project
# whose lint allows 80 columns should use WIDTH=78.

# The range of commits. All commits if there is no first argument,
# or commits since a given point.
[[ -z ${1} ]] && range="" || range=${1}^..HEAD

width=${WIDTH:-81}

# The GitHub URL of the repository we are being run in, and its name.
# A bare '#123' refers to an issue of this repository.
repo=$(git config --get remote.origin.url |
  sed -e 's!^git@github.com:!https://github.com/!' -e 's!\.git$!!')
if [[ -z ${repo} ]]; then
  echo "relNotes: no remote 'origin'; run me inside a git clone" >&2
  exit 1
fi
project=${repo##*/}

# How to name an issue of a sibling project. An issue of the project we
# are running in is bare ('#123'); one of another project is qualified
# ('morel#123'), so that the two are told apart.
morel_tag=morel; rust_tag=rust; go_tag=go
case ${project} in
  morel) morel_tag= ;;
  morel-rust) rust_tag= ;;
  morel-go) go_tag= ;;
esac

git log --abbrev-commit ${range} --pretty=format:'* %s' -- ${2} |
sed -e '
s!\[MOREL-\([0-9]*\)\] \(.*\)!\2 (#\1)!;
s!\(http.*\), !<a href="\1">#xxx</a>, !;
s!\(CALCITE-[0-9]*\)!<a href="https://issues.apache.org/jira/browse/\1">\1</a>!;
s!\(MOREL-\([0-9]*\)\)![\1](https://github.com/hydromatic/morel/issues/\2)!;
s!\(QUIDEM-\([0-9]*\)\)![\1](https://github.com/hydromatic/quidem/issues/\2)!;
s!\(SMLJ-\([0-9]*\)\)!<a href="https://github.com/hydromatic/morel/issues/\2">\1</a>!;
s!\(SQLLINE-\([0-9]*\)\)!<a href="https://github.com/julianhyde/sqlline/issues/\2">\1</a>!;
s!</a>\]!</a>]\
 !;' |
sed -e "
s!hydromatic/morel-rust#\\([0-9]*\\)![${rust_tag}#\\1](https://github.com/hydromatic/morel-rust/issues/\\1)!g;
s!hydromatic/morel-go#\\([0-9]*\\)![${go_tag}#\\1](https://github.com/hydromatic/morel-go/issues/\\1)!g;
s!hydromatic/morel#\\([0-9]*\\)![${morel_tag}#\\1](https://github.com/hydromatic/morel/issues/\\1)!g;
" |
sed -e 's!\([ (]\)#\([0-9]*\)!\1[#\2]('"${repo}"'/issues/\2)!g' |
fold -s -${width} |
sed -e 's/ *$//' |
grep '[^ ]' |
gawk '!/^\* / && !/^ / {print "  " $0;next} {print}'

# End
